pipeline {
    agent any

    tools {
        maven 'Maven3'
        nodejs 'NodeJS22'
    }

    parameters {
        booleanParam(
            name: 'DEPLOY_TO_EC2',
            defaultValue: false,
            description: 'After staging passes, request approval to deploy this exact build to EC2.'
        )
        string(
            name: 'EC2_HOST',
            defaultValue: '',
            description: 'Current EC2 public IPv4 address or DNS name. Required only for production deployment.'
        )
        string(
            name: 'AWS_REGION',
            defaultValue: 'eu-north-1',
            description: 'AWS region containing the DemoMart production secret.'
        )
        string(
            name: 'AWS_SECRET_ID',
            defaultValue: 'demomart/production/application',
            description: 'Secrets Manager name or ARN read by the EC2 instance role during deployment.'
        )
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        DOCKER_BIN = 'C:\\Users\\Lenovo\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin'
        DOCKER_COMPOSE_BIN = 'C:\\Users\\Lenovo\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins'
        DOCKER_ENV_FILE = 'DemoMart\\.env.jenkins'
    }

    stages {
        stage('Backend Build and Tests') {
            steps {
                bat 'mvn -f DemoMart/pom.xml clean verify'
            }
        }

        stage('Frontend Build') {
            steps {
                dir('DemoMart/frontend') {
                    bat 'npm install --no-audit --no-fund'
                    bat 'npm run build'
                }
            }
        }

        stage('Prepare Container Release Bundle') {
            steps {
                powershell '''
                    & '.\\DemoMart\\scripts\\prepare-production-bundle.ps1' `
                        -SourceRoot '.\\DemoMart' `
                        -BundleRoot '.\\DemoMart\\build\\production-bundle'
                '''
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts(
                    artifacts: 'DemoMart/*/target/*.jar,DemoMart/frontend/dist/**/*,DemoMart/build/production-bundle/**/*',
                    fingerprint: true
                )
            }
        }

        stage('Deploy and Verify Local Docker Staging') {
            steps {
                withCredentials([
                    string(credentialsId: 'demomart-staging-jwt-secret', variable: 'JWT_SECRET'),
                    string(credentialsId: 'demomart-staging-internal-key', variable: 'INTERNAL_SERVICE_KEY')
                ]) {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        $env:Path = "$env:DOCKER_BIN;$env:DOCKER_COMPOSE_BIN;$env:Path"
                        $env:COMPOSE_PARALLEL_LIMIT = '1'
                        $environmentFile = Join-Path $env:WORKSPACE $env:DOCKER_ENV_FILE

                        try {
                            @(
                                "JWT_SECRET=$env:JWT_SECRET"
                                "INTERNAL_SERVICE_KEY=$env:INTERNAL_SERVICE_KEY"
                                'SEED_DEMO_USERS=true'
                                'DEMOMART_HOST_PORT=5174'
                                'EUREKA_HOST_PORT=8762'
                                'IMAGE_TAG=staging'
                            ) | Set-Content -LiteralPath $environmentFile -Encoding ascii

                            & docker.exe version
                            if ($LASTEXITCODE -ne 0) {
                                throw 'Jenkins cannot connect to the Docker Desktop engine.'
                            }
                            & docker-compose.exe version
                            if ($LASTEXITCODE -ne 0) {
                                throw 'Docker Compose is unavailable to Jenkins.'
                            }

                            & '.\\DemoMart\\scripts\\start-docker.ps1' `
                                -EnvironmentFile $environmentFile
                            & '.\\DemoMart\\scripts\\verify-docker-staging.ps1' `
                                -EnvironmentFile $environmentFile `
                                -TimeoutSeconds 420
                        }
                        catch {
                            Write-Host 'Docker staging failed. Current containers:'
                            & docker-compose.exe --env-file $environmentFile ps -a
                            Write-Host 'Recent container logs:'
                            & docker-compose.exe --env-file $environmentFile logs --no-color --tail 150
                            throw
                        }
                        finally {
                            if (Test-Path -LiteralPath $environmentFile) {
                                Remove-Item -LiteralPath $environmentFile -Force
                            }
                        }
                    '''
                }
            }
        }

        stage('Approve Production Deployment') {
            when {
                expression { params.DEPLOY_TO_EC2 }
            }
            steps {
                script {
                    if (!params.EC2_HOST?.trim()) {
                        error('EC2_HOST is required when DEPLOY_TO_EC2 is selected.')
                    }
                }
                input(
                    message: "Staging is healthy. Deploy build #${env.BUILD_NUMBER} to http://${params.EC2_HOST}/demomart/?",
                    ok: 'Deploy to EC2'
                )
            }
        }

        stage('Deploy to Production (EC2)') {
            when {
                expression { params.DEPLOY_TO_EC2 }
            }
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-deploy-key',
                        keyFileVariable: 'EC2_SSH_KEY',
                        usernameVariable: 'EC2_USER'
                    )
                ]) {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        $hostName = $env:EC2_HOST.Trim()
                        $awsRegion = $env:AWS_REGION.Trim()
                        $secretId = $env:AWS_SECRET_ID.Trim()
                        if ($hostName -notmatch '^[A-Za-z0-9.-]+$') {
                            throw "EC2_HOST contains unsupported characters: $hostName"
                        }
                        if ($awsRegion -notmatch '^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$') {
                            throw "AWS_REGION is invalid: $awsRegion"
                        }
                        if ($secretId -notmatch '^[A-Za-z0-9:/_+=.@-]+$') {
                            throw 'AWS_SECRET_ID contains unsupported characters.'
                        }

                        $temporaryRoot = Join-Path $env:TEMP ("demomart-production-" + [guid]::NewGuid().ToString())
                        $keyPath = Join-Path $temporaryRoot 'ec2-key.pem'
                        $archivePath = Join-Path $temporaryRoot 'demomart-production.tar.gz'
                        $bundleRoot = Join-Path $env:WORKSPACE 'DemoMart\\build\\production-bundle'
                        $remoteRoot = "/tmp/demomart-$env:BUILD_NUMBER"
                        $remoteArchive = "$remoteRoot.tar.gz"

                        try {
                            New-Item -ItemType Directory -Path $temporaryRoot -Force | Out-Null
                            Copy-Item -LiteralPath $env:EC2_SSH_KEY -Destination $keyPath -Force
                            & icacls.exe $keyPath /inheritance:r | Out-Null
                            & icacls.exe $keyPath /grant:r 'SYSTEM:(R)' | Out-Null
                            if ($LASTEXITCODE -ne 0) {
                                throw 'Could not secure the temporary EC2 SSH key.'
                            }

                            & tar.exe '-czf' $archivePath '-C' $bundleRoot '.'
                            if ($LASTEXITCODE -ne 0) {
                                throw 'Creating the DemoMart production archive failed.'
                            }

                            & scp.exe '-o' 'BatchMode=yes' '-o' 'StrictHostKeyChecking=accept-new' '-i' $keyPath `
                                $archivePath "$($env:EC2_USER)@$hostName`:$remoteArchive"
                            if ($LASTEXITCODE -ne 0) {
                                throw 'Copying the DemoMart release archive to EC2 failed.'
                            }
                            $remoteCommand = "set -e; rm -rf '$remoteRoot'; mkdir -p '$remoteRoot'; tar -xzf '$remoteArchive' -C '$remoteRoot'; sudo bash '$remoteRoot/scripts/deploy-ec2-production.sh' '$remoteRoot' '$env:BUILD_NUMBER' '$awsRegion' '$secretId'; rm -f '$remoteArchive'; rm -rf '$remoteRoot'"
                            & ssh.exe '-o' 'BatchMode=yes' '-o' 'StrictHostKeyChecking=accept-new' '-i' $keyPath `
                                "$($env:EC2_USER)@$hostName" $remoteCommand
                            if ($LASTEXITCODE -ne 0) {
                                throw 'DemoMart EC2 deployment or its internal health checks failed.'
                            }

                            & '.\\DemoMart\\scripts\\verify-production.ps1' `
                                -BaseUrl "http://$hostName/demomart/"
                        }
                        finally {
                            if (Test-Path -LiteralPath $temporaryRoot) {
                                Remove-Item -LiteralPath $temporaryRoot -Recurse -Force
                            }
                        }
                    '''
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                testResults: 'DemoMart/**/target/surefire-reports/TEST-*.xml'
        }
        success {
            script {
                if (params.DEPLOY_TO_EC2) {
                    echo "DemoMart build #${env.BUILD_NUMBER} passed staging and production deployment at http://${params.EC2_HOST}/demomart/."
                } else {
                    echo 'DemoMart build, tests, Docker staging deployment, and container health checks passed.'
                }
            }
        }
        failure {
            echo 'DemoMart pipeline failed. Review the failed stage before attempting another deployment.'
            mail(
                to: 'mridul.mathur84@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "DemoMart pipeline failed. Review: ${env.BUILD_URL}"
            )
        }
    }
}
