# Copy this file to .env before running Docker Compose locally.
# Replace both example values with different random values of at least 32 characters.
JWT_SECRET=replace-with-a-random-local-jwt-secret-at-least-32-characters
INTERNAL_SERVICE_KEY=replace-with-a-different-random-local-key-at-least-32-characters
SEED_DEMO_USERS=true
DEMOMART_HOST_PORT=5174
EUREKA_HOST_PORT=8762
IMAGE_TAG=local

