AI_API_KEY=replace-with-groq-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_MAX_OUTPUT_TOKENS=5000

JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
JIRA_PROJECT_KEY=PROJECT
JIRA_READY_STATUS=Ready for AI Planning
JIRA_HUMAN_REVIEW_STATUS=Human Review Required
JIRA_DEVELOPMENT_STATUS=In Development
JIRA_TESTING_STATUS=In Testing
JIRA_STAGING_STATUS=Ready for Staging
JIRA_COMPLETED_STATUS=Done
JIRA_HUMAN_GATEKEEPER_ACCOUNT_ID=replace-with-atlassian-account-id

MAX_AUTO_FIX_ATTEMPTS=1
PLANNER_MAX_EPICS_PER_RUN=5
PLANNER_POLL_DELAY_MILLISECONDS=60000
PLANNER_SCHEDULER_ENABLED=false

# MVP2 remains inactive until explicitly enabled. Generate a long random control token.
AUTOMATION_ENABLED=false
AUTOMATION_CONTROL_TOKEN=replace-with-long-random-token
AUTOMATION_PROJECT_KEY=DMT
# Docker mounts this host Git repository at /workspace inside the planner container.
AUTOMATION_HOST_REPOSITORY_ROOT=C:/path/to/development-workspace
AUTOMATION_REPOSITORY_ROOT=/workspace
AUTOMATION_ALLOWED_DIRECTORY=DemoMart
AUTOMATION_BASE_BRANCH=main
AUTOMATION_GIT_REMOTE=origin
AUTOMATION_BRANCH_PREFIX=ai/epic-
AUTOMATION_STAGING_JOB=demomart-staging
AUTOMATION_WORKER_MODE=dry-run
# Command mode must use scripts/run-windows.ps1; the Linux Docker container supports dry-run only.
# These are the only commands the Windows worker may execute.
AUTOMATION_DEVELOPMENT_COMMAND=powershell -ExecutionPolicy Bypass -File scripts/ai-development.ps1
AUTOMATION_STAGING_DEPLOY_COMMAND=powershell -ExecutionPolicy Bypass -File scripts/deploy-local.ps1
AUTOMATION_STAGING_HEALTH_URL=http://127.0.0.1:5174/
AUTOMATION_GIT_TIMEOUT_SECONDS=60
MAX_DEVELOPMENT_FIX_ATTEMPTS=1
AUTOMATION_DATA_PATH=./data/automation
DASHBOARD_MAX_ISSUES=200
DASHBOARD_STUCK_AFTER_MINUTES=60
